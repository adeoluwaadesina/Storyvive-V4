# Storyvive V4 environment (template). Copy to .env and fill in real values.
# .env is gitignored; never put real secrets in this .example file.

# Neon Postgres connection string for the canon cache (task 10).
# Create a project at https://neon.tech, copy the "Pooled connection" string.
# Without this, the extractor still runs fully; it just won't cache.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
