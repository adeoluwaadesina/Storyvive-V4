# Storyvive V4 environment (template). Copy to .env and fill in real values.
# .env is gitignored; never put real secrets in this .example file.

# Neon Postgres connection string for the canon cache (task 10).
# Create a project at https://neon.tech, copy the "Pooled connection" string.
# Without this, the extractor still runs fully; it just won't cache.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# OpenAI: chunk/query embeddings (text-embedding-3-small, 1536 dims) AND
# the story-writer model (gpt-4o). Both --cache and --generate need this.
OPENAI_API_KEY=sk-...

# NextAuth (email/password sign-in; Google provider to be added later).
# NEXTAUTH_URL should be your deployed URL in production (or localhost for dev).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with: openssl rand -base64 32
